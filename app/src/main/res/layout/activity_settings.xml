<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Switch
            android:id="@+id/sw_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_enabled"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pref_translation_header"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_translation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_translation" />

        <Button
            android:id="@+id/btn_delete_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_translation" />

        <!-- Formatting options - mirror the Windows config.json flags -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pref_formatting_header"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_include_reference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_include_reference" />

        <CheckBox
            android:id="@+id/cb_reference_first_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_reference_first_line" />

        <CheckBox
            android:id="@+id/cb_dynamic_reference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_dynamic_reference" />

        <CheckBox
            android:id="@+id/cb_verse_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_verse_numbers" />

        <CheckBox
            android:id="@+id/cb_new_line_chapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_new_line_chapters" />

        <CheckBox
            android:id="@+id/cb_new_line_books"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_new_line_books" />

        <!-- Live sample so the six flags above explain themselves -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/preview_header"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pref_switching_header"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_switch_permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/code_block_background"
            android:padding="12dp"
            android:text="@string/adb_instruction"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
